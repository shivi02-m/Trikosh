# Copy this file to .env on the VPS and edit it:   cp .env.example .env && nano .env
# .env is read automatically by `docker compose` from the folder that contains compose.yaml.
# compose.yaml passes DOMAIN to the Caddy container as an environment variable, and the
# Caddyfile reads it as {$DOMAIN} to know which hostname to serve and get a certificate for.
# Never commit .env. It is listed in .gitignore and excluded from the Docker image by .dockerignore.

# Your domain, with no https:// and no trailing slash. Its DNS A record must point to the VPS.
# To serve www too, list both (only after BOTH DNS records point to the VPS):
#   DOMAIN=trikosh.com, www.trikosh.com
DOMAIN=trikosh.com

# Email: used for password reset ("Forgot password?") and for Household/Business member invitations.
# Leave SMTP_PASS empty to keep both off (invitations then report exactly which settings are missing).
# GoDaddy email (admin@trikosh.com): server smtpout.secureserver.net, port 587 (or 465). Use the mailbox password.
# Reset and invitation links use https://DOMAIN (the first one if several are listed).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=admin@trikosh.com
SMTP_PASS=
SMTP_FROM=admin@trikosh.com
